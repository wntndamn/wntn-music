# http:// keeps Caddy on plain HTTP locally (so audio from http://localhost:9000
# isn't mixed-content). On a VPS use a bare domain for auto-HTTPS.
DOMAIN=http://localhost
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false

POSTGRES_PASSWORD=wntn-dev
SESSION_SECRET=dev-only-secret-change-in-prod-0123456789abcdef
# usernames (через запятую) с правами модерации
ADMIN_USERNAMES=admin

S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wntn
S3_SECRET_ACCESS_KEY=wntn-dev-secret
S3_BUCKET=wntn-audio
S3_FORCE_PATH_STYLE=true
