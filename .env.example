# copy to .env and fill in.
#
# ── local ────────────────────────────────────────────────────────────────────
# http:// keeps Caddy on plain HTTP (so audio isn't mixed-content on localhost).
DOMAIN=http://localhost
S3_DOMAIN=http://cdn.localhost
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false
S3_PUBLIC_ENDPOINT=http://localhost:9000
#
# ── production (music.wntn.one + music.wntn.ru) ──────────────────────────────
# Point A/AAAA records for all three names at the VPS, then use:
#
#   DOMAIN="music.wntn.one music.wntn.ru"   # Caddy gets a cert per host
#   S3_DOMAIN=cdn.music.wntn.one            # storage behind its own hostname
#   WEB_ORIGIN=https://music.wntn.one,https://music.wntn.ru
#   COOKIE_SECURE=true
#   S3_PUBLIC_ENDPOINT=https://cdn.music.wntn.one
#
# S3_PUBLIC_ENDPOINT is baked into presigned URLs, so it must be the public
# storage hostname; S3_ENDPOINT stays internal (api -> s3 container).

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# usernames (comma-separated) promoted to root on boot — day-to-day admin
# grants happen in /admin, this is only the bootstrap
ADMIN_USERNAMES=

# S3-compatible object storage (audio/covers/avatars).
# Local rustfs (docker compose) defaults below.
#
# Cloudflare R2 instead:
#   S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   S3_PUBLIC_BASE_URL=https://<your-r2-custom-domain>   # public bucket domain
#   S3_REGION=auto
#   S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY from the R2 API token
#   S3_BUCKET=<bucket>
#   S3_FORCE_PATH_STYLE=false
# With S3_PUBLIC_BASE_URL set, S3_PUBLIC_ENDPOINT/S3_DOMAIN are unused (no
# presigning, no local s3 container in the request path).
S3_ENDPOINT=http://s3:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wntn
S3_SECRET_ACCESS_KEY=wntn-dev-secret
S3_BUCKET=wntn-audio
S3_FORCE_PATH_STYLE=true
