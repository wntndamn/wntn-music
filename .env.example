# copy to .env and fill in.
#
# ── local ────────────────────────────────────────────────────────────────────
# http:// keeps Caddy on plain HTTP (so audio isn't mixed-content on localhost).
DOMAIN=http://localhost
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false
#
# ── production (music.wntn.one + music.wntn.ru) ──────────────────────────────
# Point A/AAAA records for all three names at the VPS, then use:
#
#   DOMAIN="music.wntn.one music.wntn.ru"   # Caddy gets a cert per host
#   WEB_ORIGIN=https://music.wntn.one,https://music.wntn.ru
#   COOKIE_SECURE=true
#

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# usernames (comma-separated) promoted to root on boot — day-to-day admin
# grants happen in /admin, this is only the bootstrap
ADMIN_USERNAMES=

# Object storage (audio/covers/avatars) — Cloudflare R2 in production.
# Keys come from an R2 API token scoped to the bucket.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Public bucket domain: objects are served straight off it, no presigning.
S3_PUBLIC_BASE_URL=https://<r2-custom-domain>
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=wntn-music
S3_FORCE_PATH_STYLE=false
#
# Want storage locally instead? Run any S3 server yourself, e.g.
#   docker run -d -p 9000:9000 -v wntn-s3:/data rustfs/rustfs /data
# then S3_ENDPOINT=http://localhost:9000, S3_PUBLIC_ENDPOINT=http://localhost:9000,
# S3_FORCE_PATH_STYLE=true and leave S3_PUBLIC_BASE_URL empty (URLs get presigned).
