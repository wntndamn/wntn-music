# copy to .env and fill in
DOMAIN=localhost
WEB_ORIGIN=http://localhost
COOKIE_SECURE=false

POSTGRES_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string-min-32-chars
# usernames (comma-separated) that can moderate artist-ownership claims at /admin
ADMIN_USERNAMES=

# S3-compatible object storage (audio/covers).
# Local rustfs (docker compose) defaults below. For R2/AWS: set the provider
# endpoint, real keys, and S3_FORCE_PATH_STYLE=false.
# NOTE: S3_ENDPOINT must be reachable by both the api and the browser
# (presigned URLs are host-bound). On a VPS, front s3 with a domain.
# S3_ENDPOINT: how the api reaches storage. S3_PUBLIC_ENDPOINT: baked into
# presigned URLs (must be browser-reachable). In docker they differ; on a VPS
# set S3_PUBLIC_ENDPOINT to your storage domain.
S3_ENDPOINT=http://s3:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=wntn
S3_SECRET_ACCESS_KEY=wntn-dev-secret
S3_BUCKET=wntn-audio
S3_FORCE_PATH_STYLE=true
