# Local: DOMAIN=http://localhost (plain HTTP, no cert).
# Prod: DOMAIN="music.wntn.one music.wntn.ru" — Caddy fetches a cert per host.
{$DOMAIN:localhost} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		# hashed asset names are immutable; index.html must never stick
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@html path / /index.html
		header @html Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
